{
  "name": "tree-sitter-snowflake",
  "version": "0.1.1",
  "description": "Tree-sitter grammar for Snowflake SQL",
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "npx --yes --package=tree-sitter-cli@0.27.0 -- tree-sitter build --wasm",
    "start": "npx --yes --package=tree-sitter-cli@0.27.0 -- tree-sitter playground",
    "test": "node --test bindings/node/*_test.js",
    "lint": "eslint grammar.js \"grammar/**/*.js\" \"tools/**/*.mjs\" \"bindings/node/*.js\"",
    "format": "prettier --write grammar.js \"grammar/**/*.js\" \"tools/**/*.mjs\" \"bindings/node/*.js\"",
    "format:check": "prettier --check grammar.js \"grammar/**/*.js\" \"tools/**/*.mjs\" \"bindings/node/*.js\""
  },
  "author": "M. Reifschneider",
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "8.9.2",
    "node-gyp-build": "4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "node-gyp": "13.0.2",
    "prettier": "3.9.9",
    "tree-sitter": "0.25.1",
    "tree-sitter-cli": "0.27.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "gypfile": true,
  "directories": {
    "test": "test"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meloncholera/tree-sitter-snowflake.git"
  },
  "bugs": {
    "url": "https://github.com/meloncholera/tree-sitter-snowflake/issues"
  },
  "homepage": "https://github.com/meloncholera/tree-sitter-snowflake#readme",
  "keywords": [
    "parser",
    "sql",
    "snowflake",
    "tree-sitter"
  ],
  "files": [
    "grammar.js",
    "grammar/**",
    "binding.gyp",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "prebuilds/**",
    "tree-sitter.json",
    "NOTICE"
  ],
  "allowScripts": {
    "tree-sitter-cli@0.27.0": true,
    "tree-sitter@0.25.1": true
  },
  "prettier": {
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  }
}
