{
  "name": "tree-sitter-snowflake",
  "version": "0.2.0",
  "description": "Tree-sitter grammar for Snowflake SQL",
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  },
  "author": "M. Reifschneider",
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.27.0",
    "node-gyp": "^13.0.2",
    "tree-sitter": "^0.25.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "gypfile": true,
  "directories": {
    "test": "test"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meloncholic/tree-sitter-snowflake.git"
  },
  "bugs": {
    "url": "https://github.com/meloncholic/tree-sitter-snowflake/issues"
  },
  "homepage": "https://github.com/meloncholic/tree-sitter-snowflake#readme",
  "keywords": [
    "parser",
    "sql",
    "snowflake",
    "tree-sitter"
  ],
  "files": [
    "grammar.js",
    "grammar/**",
    "binding.gyp",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "tree-sitter.json",
    "NOTICE"
  ],
  "allowScripts": {
    "tree-sitter-cli@0.27.0": true,
    "tree-sitter@0.25.1": true
  }
}
